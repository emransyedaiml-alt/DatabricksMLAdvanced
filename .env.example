# Copy to .env for LOCAL runs only. Never commit real values. On Databricks, authentication is automatic.
DATABRICKS_HOST=https://adb-<workspace-id>.<n>.azuredatabricks.net
DATABRICKS_TOKEN=<personal-access-token-or-leave-empty-and-use-a-CLI-profile>

# Profile: learning (default) or enterprise
EIKA_PROFILE=learning

# Any config value can be overridden: EIKA__<SECTION>__<KEY>=value
# EIKA__LLM__ENDPOINT=databricks-meta-llama-3-3-70b-instruct
# EIKA__EMBEDDING__PROVIDER=hashing          # offline, learning-only embedder
# EIKA__AGENT__MODE=rules                    # deterministic planner, no LLM needed
# EIKA__VECTOR_STORE__ENDPOINT_NAME=eika-vs-endpoint
